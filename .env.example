# Copy to .env (never committed). The factory core needs NO secrets today.
# Remote panel (Vercel + Postgres) bridge — leave empty until you've created the DB:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Future integrations (examples only, leave empty until used):
# ANTHROPIC_API_KEY=
# KDP_EMAIL=            # never store marketplace passwords here; use a password manager
# CHROME_PATH=          # optional override for headless Chrome/Edge
